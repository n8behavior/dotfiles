{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "agentPushNotifEnabled": true,
  "alwaysThinkingEnabled": true,
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true
  },
  "env": {
    "BASH_ENV": "/home/sandman/.bash_functions",
    "CLAUDE_CODE_TMPDIR": "/home/sandman/.cache/claude-tmp"
  },
  "feedbackSurveyState": {
    "lastShownTime": 1754015932533
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [],
        "matcher": ""
      }
    ]
  },
  "includeCoAuthoredBy": false,
  "mcpServers": {
    "github": {
      "args": [
        "-c",
        "source ~/.bashrc && GITHUB_PERSONAL_ACCESS_TOKEN=\"$GITHUB_TOKEN\" /home/sandman/.local/bin/github-mcp-server stdio"
      ],
      "command": "bash"
    }
  },
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "xhigh"
    }
  },
  "permissions": {
    "allow": [
      "Bash(gh pr create *)",
      "Bash(gh pr merge * --auto --squash)",
      "Bash(gh pr comment *)",
      "Bash(gh pr view *)",
      "Bash(gh api repos/n8behavior/dotfiles/statuses/*)",
      "Bash(gh pr merge --auto --squash *)",
      "Bash(gh pr checks *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh issue create *)",
      "Bash(gh issue comment *)",
      "Bash(gh issue edit *)"
    ],
    "defaultMode": "auto",
    "deny": [
      "Bash(gh pr merge *--admin*)"
    ]
  },
  "remoteControlAtStartup": true,
  "skipWorkflowUsageWarning": true,
  "theme": "auto",
  "tui": "default",
  "voiceEnabled": true
}
