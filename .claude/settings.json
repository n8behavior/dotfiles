{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "agentPushNotifEnabled": true,
  "alwaysThinkingEnabled": true,
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true
  },
  "env": {
    "BASH_ENV": "/home/sandman/.bash_functions",
    "CLAUDE_CODE_TMPDIR": "/home/sandman/.cache/claude-tmp"
  },
  "extraKnownMarketplaces": {
    "riff": {
      "source": {
        "path": "/home/sandman/.local/share/riff/claude-plugin",
        "source": "directory"
      }
    }
  },
  "feedbackSurveyState": {
    "lastShownTime": 1754015932533
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [],
        "matcher": ""
      }
    ]
  },
  "includeCoAuthoredBy": false,
  "mcpServers": {
    "github": {
      "args": [
        "-c",
        "source ~/.bashrc && GITHUB_PERSONAL_ACCESS_TOKEN=\"$GITHUB_TOKEN\" /home/sandman/.local/bin/github-mcp-server stdio"
      ],
      "command": "bash"
    }
  },
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "xhigh"
    }
  },
  "permissions": {
    "allow": [
      "mcp__plugin_riff_riff",
      "mcp__riff",
      "Bash(riff)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge * --auto --squash)",
      "Bash(gh pr comment *)",
      "Bash(gh pr view *)",
      "Bash(gh api repos/n8behavior/dotfiles/statuses/*)"
    ],
    "defaultMode": "auto",
    "deny": [
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push *:main)",
      "Bash(git push *:main *)",
      "Bash(git push *:refs/heads/main)",
      "Bash(git push *:refs/heads/main *)",
      "Bash(gh pr merge *--admin*)"
    ]
  },
  "remoteControlAtStartup": true,
  "skipWorkflowUsageWarning": true,
  "statusLine": {
    "command": "riff statusline",
    "type": "command"
  },
  "theme": "auto",
  "tui": "default",
  "voiceEnabled": true
}
