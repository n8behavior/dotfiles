# Non-secret config for the Sagemcom cable modem probe / DOCSIS collector.
#
# The admin password is deliberately NOT here: it is decrypted from passage
# into ~/.local/etc/modem-admin (0600, untracked) by bootstrap-dotfiles.
#
# MODEM_USER is the stock Sagemcom account name, printed on the device label.
# It is not a secret, so keeping it here costs no extra YubiKey touch at
# bootstrap, mirroring how unifi.env carries host/site next to unifi-api-key.
#
# The modem serves a self-signed certificate on its DOCSIS diagnostic address,
# so the probe passes --ignore-certificate-errors. This is a link-local hop to
# the modem itself, not traffic crossing an untrusted network.
MODEM_HOST="https://192.168.100.1"
MODEM_USER="admin"
MODEM_GUI_PATH="/2.0/gui/"
