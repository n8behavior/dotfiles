# Shared config for enroll-fido-key and setup-fido-login.
#
# FIDO2 credentials are bound to the relying-party ID they were registered
# against. pamu2fcfg and pam_u2f both default this to pam://$HOSTNAME, which
# would bind each credential to a single machine. Pinning it to a fixed value
# lets one u2f_keys mapping authenticate on every host.
#
# Changing FIDO_ORIGIN invalidates every existing credential.
FIDO_ORIGIN="pam://n8behavior"
FIDO_APPID="pam://n8behavior"
