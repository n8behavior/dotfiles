# Non-secret config for the unifi-mcp launcher.
#
# The API key is deliberately NOT here: it is decrypted from passage into
# ~/.local/etc/unifi-api-key (0600, untracked) by bootstrap-dotfiles.
#
# UNIFI_VERIFY_SSL is off because the UDM SE serves a self-signed certificate
# (CN=unifi.local, self-issued) that also mismatches the IP we connect on.
# Verification would fail on both counts. This is a link-local hop to the
# gateway itself, not traffic crossing an untrusted network.
UNIFI_HOST="https://192.168.1.1"
UNIFI_SITE="default"
UNIFI_VERIFY_SSL="false"
