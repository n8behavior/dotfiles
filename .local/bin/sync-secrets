#!/usr/bin/env bash
set -e

RECOVERY_PATH="/media/sandman/Recovery/secrets"
PASSAGE_STORE="$HOME/.passage/store"

ASSUME_YES=0

usage() {
  cat <<EOF
Usage: $(basename "$0") <command> [--yes]

Commands:
  push    Copy local passage store TO recovery drive (after adding secrets or re-encrypting)
  pull    Copy passage store FROM recovery drive to local (sync to this machine)
  status  Show differences between local and recovery drive

Options:
  -y, --yes   Skip the confirmation prompt, for callers like bootstrap-dotfiles

Both directions copy with timestamps preserved and never replace a file with an
older one. An entry's mtime is written by \`passage insert\` and then travels
with the file, so it acts as a version stamp and the newest copy of a secret
wins no matter which machine wrote it.

Examples:
  # After adding a new secret or re-encrypting with new YubiKey
  $(basename "$0") push

  # Setting up a new machine or syncing updates
  $(basename "$0") pull
EOF
  exit 1
}

check_recovery_drive() {
  if [[ ! -d "$RECOVERY_PATH" ]]; then
    echo "ERROR: Recovery drive not mounted at $RECOVERY_PATH"
    exit 1
  fi
}

check_passage_store() {
  if [[ ! -d "$PASSAGE_STORE" ]]; then
    echo "ERROR: Local passage store not found at $PASSAGE_STORE"
    exit 1
  fi
}

# Filled in by plan_sync: what a copy would move, hold back, and leave alone.
COPY=()
HELD=()
EXTRA=()

# Compare SRC against DST without touching either. A file is copied when it is
# missing from DST, or when the contents differ and SRC's mtime is newer. When
# DST's copy is the newer one it is held back instead, so a sync in either
# direction can never roll a secret backwards. Equal mtimes with differing
# content also hold back: with nothing to separate them, the safe move is to
# leave the destination alone and let the user look.
plan_sync() {
  local src=$1 dst=$2 rel s d
  COPY=()
  HELD=()
  EXTRA=()

  while IFS= read -r -d '' s; do
    rel=${s#"$src"/}
    d="$dst/$rel"
    if [[ ! -e "$d" ]]; then
      COPY+=("$rel")
    elif cmp -s "$s" "$d"; then
      continue
    elif [[ "$s" -nt "$d" ]]; then
      COPY+=("$rel")
    else
      HELD+=("$rel")
    fi
  done < <(find "$src" -type f -print0)

  while IFS= read -r -d '' d; do
    rel=${d#"$dst"/}
    [[ -e "$src/$rel" ]] || EXTRA+=("$rel")
  done < <(find "$dst" -type f -print0)
}

print_plan() {
  local rel
  if ((${#COPY[@]})); then
    echo "  Copy (${#COPY[@]}):"
    for rel in "${COPY[@]}"; do echo "    + $rel"; done
  fi
  if ((${#HELD[@]})); then
    echo "  Held back, destination is newer (${#HELD[@]}):"
    for rel in "${HELD[@]}"; do echo "    ! $rel"; done
  fi
  if ((${#EXTRA[@]})); then
    echo "  Only in destination, left alone (${#EXTRA[@]}):"
    for rel in "${EXTRA[@]}"; do echo "    - $rel"; done
  fi
}

# Copy exactly what plan_sync listed, so the preview and the action cannot drift
# apart. -p keeps the mtime, which is the whole basis for the comparison above.
apply_plan() {
  local src=$1 dst=$2 rel
  for rel in "${COPY[@]}"; do
    mkdir -p "$dst/$(dirname "$rel")"
    cp -p "$src/$rel" "$dst/$rel"
  done
}

confirm() {
  if ((ASSUME_YES)); then
    return 0
  fi
  read -p "Continue? [y/N] " -n 1 -r
  echo
  [[ $REPLY =~ ^[Yy]$ ]]
}

do_push() {
  check_recovery_drive
  check_passage_store
  mkdir -p "$RECOVERY_PATH/passage-store"

  echo "Pushing local passage store to recovery drive..."
  echo "  From: $PASSAGE_STORE"
  echo "  To:   $RECOVERY_PATH/passage-store/"
  echo ""

  plan_sync "$PASSAGE_STORE" "$RECOVERY_PATH/passage-store"
  print_plan
  if ((${#COPY[@]} == 0)); then
    echo "  Nothing to copy."
    return 0
  fi
  echo ""

  if confirm; then
    apply_plan "$PASSAGE_STORE" "$RECOVERY_PATH/passage-store"
    echo "Done. Recovery drive updated."
  else
    echo "Aborted."
  fi
}

do_pull() {
  check_recovery_drive

  echo "Pulling passage store from recovery drive..."
  echo "  From: $RECOVERY_PATH/passage-store/"
  echo "  To:   $PASSAGE_STORE"
  echo ""

  mkdir -p "$PASSAGE_STORE"
  chmod 700 "$PASSAGE_STORE"

  plan_sync "$RECOVERY_PATH/passage-store" "$PASSAGE_STORE"
  print_plan
  if ((${#COPY[@]} == 0)); then
    echo "  Nothing to copy."
  else
    echo ""
    if confirm; then
      apply_plan "$RECOVERY_PATH/passage-store" "$PASSAGE_STORE"
      echo "Done. Local passage store updated."
    else
      echo "Aborted."
      return 0
    fi
  fi

  # Remind about identity setup if needed
  if [[ ! -f "$HOME/.passage/identities" ]]; then
    echo ""
    echo "NOTE: No identity file found. Run:"
    echo "  age-plugin-yubikey --identity > ~/.passage/identities"
  fi
}

do_status() {
  check_recovery_drive
  check_passage_store

  echo "Comparing local passage store with recovery drive..."
  echo ""

  plan_sync "$RECOVERY_PATH/passage-store" "$PASSAGE_STORE"
  if ((${#COPY[@]} == 0 && ${#HELD[@]} == 0 && ${#EXTRA[@]} == 0)); then
    echo "In sync - no differences found."
    return 0
  fi

  # Stated from pull's point of view: what it would bring down, and what it
  # would hold back because this machine has the newer copy - that second list
  # is what a push would send.
  echo "pull would:"
  print_plan
}

CMD=""
while (($#)); do
  case "$1" in
    push|pull|status) CMD=$1 ;;
    -y|--yes)         ASSUME_YES=1 ;;
    *)                usage ;;
  esac
  shift
done

case "$CMD" in
  push)   do_push ;;
  pull)   do_pull ;;
  status) do_status ;;
  *)      usage ;;
esac
