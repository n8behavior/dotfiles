#!/usr/bin/env bash
set -e

RECOVERY_PATH="/media/sandman/Recovery/secrets"
PASSAGE_STORE="$HOME/.passage/store"

usage() {
  cat <<EOF
Usage: $(basename "$0") <command>

Commands:
  push    Copy local passage store TO recovery drive (after adding secrets or re-encrypting)
  pull    Copy passage store FROM recovery drive to local (sync to this machine)
  status  Show differences between local and recovery drive

Examples:
  # After adding a new secret or re-encrypting with new YubiKey
  $(basename "$0") push

  # Setting up a new machine or syncing updates
  $(basename "$0") pull
EOF
  exit 1
}

check_recovery_drive() {
  if [[ ! -d "$RECOVERY_PATH" ]]; then
    echo "ERROR: Recovery drive not mounted at $RECOVERY_PATH"
    exit 1
  fi
}

check_passage_store() {
  if [[ ! -d "$PASSAGE_STORE" ]]; then
    echo "ERROR: Local passage store not found at $PASSAGE_STORE"
    exit 1
  fi
}

do_push() {
  check_recovery_drive
  check_passage_store

  echo "Pushing local passage store to recovery drive..."
  echo "  From: $PASSAGE_STORE"
  echo "  To:   $RECOVERY_PATH/passage-store/"

  # Show what will change
  echo ""
  echo "Changes:"
  diff -rq "$PASSAGE_STORE" "$RECOVERY_PATH/passage-store" 2>/dev/null || true
  echo ""

  read -p "Continue? [y/N] " -n 1 -r
  echo
  if [[ $REPLY =~ ^[Yy]$ ]]; then
    cp -r "$PASSAGE_STORE/." "$RECOVERY_PATH/passage-store/"
    echo "Done. Recovery drive updated."
  else
    echo "Aborted."
  fi
}

do_pull() {
  check_recovery_drive

  echo "Pulling passage store from recovery drive..."
  echo "  From: $RECOVERY_PATH/passage-store/"
  echo "  To:   $PASSAGE_STORE"

  mkdir -p "$PASSAGE_STORE"

  # Show what will change
  if [[ -d "$PASSAGE_STORE" ]] && [[ "$(ls -A "$PASSAGE_STORE" 2>/dev/null)" ]]; then
    echo ""
    echo "Changes:"
    diff -rq "$RECOVERY_PATH/passage-store" "$PASSAGE_STORE" 2>/dev/null || true
    echo ""
  fi

  read -p "Continue? [y/N] " -n 1 -r
  echo
  if [[ $REPLY =~ ^[Yy]$ ]]; then
    cp -r "$RECOVERY_PATH/passage-store/." "$PASSAGE_STORE/"
    chmod 700 "$PASSAGE_STORE"
    echo "Done. Local passage store updated."

    # Remind about identity setup if needed
    if [[ ! -f "$HOME/.passage/identities" ]]; then
      echo ""
      echo "NOTE: No identity file found. Run:"
      echo "  age-plugin-yubikey --identity > ~/.passage/identities"
    fi
  else
    echo "Aborted."
  fi
}

do_status() {
  check_recovery_drive
  check_passage_store

  echo "Comparing local passage store with recovery drive..."
  echo ""

  if diff -rq "$PASSAGE_STORE" "$RECOVERY_PATH/passage-store" > /dev/null 2>&1; then
    echo "In sync - no differences found."
  else
    echo "Differences found:"
    diff -rq "$PASSAGE_STORE" "$RECOVERY_PATH/passage-store" 2>/dev/null || true
  fi
}

case "${1:-}" in
  push)   do_push ;;
  pull)   do_pull ;;
  status) do_status ;;
  *)      usage ;;
esac
