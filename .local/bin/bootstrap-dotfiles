#!/usr/bin/env bash

set -e
cd "$HOME"

# Recovery drive paths: the root carries the sync-secrets symlink, which is the
# only copy present before the dotfiles are cloned.
RECOVERY_ROOT="/media/sandman/Recovery"
RECOVERY_PATH="$RECOVERY_ROOT/secrets"

install-common-packages() {
  echo 'INSTALLING: common-packages'
  sudo apt install -y xclip build-essential gnupg curl tmux tree git{,-lfs,-extras} etckeeper software-properties-common fuse2fs pcscd libpcsclite-dev pkgconf sassc
  sudo apt remove -y nano
  git lfs install
}

install-passage() {
  echo 'INSTALLING: passage + age tools'
  type -p rustup || setup-rust
  . "$HOME/.cargo/env"

  # Install rage (Rust age implementation) and YubiKey plugin
  cargo install rage age-plugin-yubikey

  # Create symlinks for age compatibility
  sudo ln -sf "$HOME/.cargo/bin/rage" /usr/local/bin/age
  sudo ln -sf "$HOME/.cargo/bin/rage-keygen" /usr/local/bin/age-keygen

  # Install passage
  if [[ ! -f /usr/local/bin/passage ]]; then
    git clone https://github.com/FiloSottile/passage.git /tmp/passage
    sudo cp /tmp/passage/src/password-store.sh /usr/local/bin/passage
    sudo chmod +x /usr/local/bin/passage
    rm -rf /tmp/passage
  fi
}

# What restore-secret last wrote out: the version of the ciphertext, and the
# mtime the file had when it was written. Together they say whether the copy on
# disk is current, and whether anything has touched it since.
SECRET_STATE="$HOME/.local/state/bootstrap-secrets"

# Decrypt one passage entry to a file, unless there is a reason not to: the
# entry is not in the store yet; the copy on disk was already written from this
# version of the ciphertext; or that copy has been modified since it was
# written, which means a credential rotated locally (Claude's token, an
# appended known_hosts) would be rolled back by an older copy from the drive.
# The version test also matters for the YubiKey: every decrypt costs a touch,
# so an unchanged store must not ask for twenty of them.
# Usage: restore-secret <entry> <dest> [mode]
restore-secret() {
  local entry=$1 dest=$2 mode=${3:-600}
  local age="$HOME/.passage/store/$entry.age"
  local stamp="$SECRET_STATE/$entry"
  local version stamped_version stamped_mtime tmp

  # Probe the ciphertext rather than decrypting: a decrypt needs the YubiKey
  # and a touch, and redirecting its output hides the prompt asking for one.
  if [[ ! -f "$age" ]]; then
    echo "  SKIP  $entry (not yet in passage)"
    return 0
  fi

  version=$(stat -c %Y "$age")
  if [[ ! -e "$dest" ]]; then
    : # nothing on disk to protect
  elif [[ -f "$stamp" ]]; then
    read -r stamped_version stamped_mtime < "$stamp" || true
    if [[ "$stamped_version" == "$version" ]]; then
      echo "  SKIP  $entry (already at the store's version)"
      return 0
    fi
    # The store moved on. Its copy is the newest one that exists unless this
    # machine has since written the file behind passage's back - which is what
    # an mtime other than the one left by the last restore means. Comparing the
    # file against the ciphertext's own mtime would not do here: the file is
    # stamped with the moment it was restored, not the version it holds, so it
    # always looks newer than the entry it came from.
    if [[ "$(stat -c %Y "$dest")" != "$stamped_mtime" ]]; then
      echo "  HOLD  $entry ($dest changed since it was restored)"
      echo "        keep it with: passage insert $entry && sync-secrets push"
      return 0
    fi
  elif [[ "$dest" -nt "$age" ]]; then
    # No record of ever writing this one, so there is nothing better to go on
    # than the two timestamps. Keep whichever is newer.
    echo "  HOLD  $entry ($dest is newer than the store's copy)"
    echo "        keep it with: passage insert $entry && sync-secrets push"
    return 0
  fi

  echo "  WRITE $entry -> $dest (touch YubiKey when prompted)"
  mkdir -p "$(dirname "$dest")"
  # Decrypt to a neighbouring temp file: a failed decrypt under `set -e` would
  # otherwise leave the destination truncated to nothing.
  tmp=$(mktemp "$dest.XXXXXX")
  chmod "$mode" "$tmp"
  if passage show "$entry" > "$tmp"; then
    mv "$tmp" "$dest"
    mkdir -p "$(dirname "$stamp")"
    echo "$version $(stat -c %Y "$dest")" > "$stamp"
  else
    rm -f "$tmp"
    echo "ERROR: could not decrypt $entry"
    return 1
  fi
}

restore-secrets() {
  echo 'RESTORING: secrets from Recovery drive'

  if [[ ! -d "$RECOVERY_PATH/passage-store" ]]; then
    echo "ERROR: Recovery drive not found at $RECOVERY_PATH"
    echo "Please mount the Recovery drive and try again."
    exit 1
  fi

  # The store copy belongs to sync-secrets: it preserves timestamps and never
  # replaces an entry with an older one, so re-running this script on a
  # provisioned machine cannot roll back a secret added since the last push.
  # Prefer the drive's copy - on a fresh machine the dotfiles are not cloned
  # yet, and the drive root symlinks it in for exactly this case.
  local sync_secrets="$RECOVERY_ROOT/sync-secrets"
  [[ -x "$sync_secrets" ]] || sync_secrets="$HOME/.local/bin/sync-secrets"
  "$sync_secrets" pull --yes

  # Setup YubiKey identity for passage. Written once and then left alone:
  # regenerating it against whichever key happens to be attached would narrow
  # the identity file to that one key. Adding a key is a separate flow, in the
  # recovery drive's README.
  if [[ -f "$HOME/.passage/identities" ]]; then
    echo "SKIPPING: YubiKey identity (~/.passage/identities already present)"
  else
    echo "Please insert your YubiKey..."
    mkdir -p "$HOME/.passage"
    age-plugin-yubikey --identity > "$HOME/.passage/identities"
  fi

  echo "Restoring SSH keys..."
  mkdir -p ~/.ssh && chmod 700 ~/.ssh
  restore-secret ssh/id_ed25519     ~/.ssh/id_ed25519
  restore-secret ssh/id_ed25519.pub ~/.ssh/id_ed25519.pub 644
  restore-secret ssh/id_rsa         ~/.ssh/id_rsa
  restore-secret ssh/id_rsa.pub     ~/.ssh/id_rsa.pub     644
  restore-secret ssh/known_hosts    ~/.ssh/known_hosts    644

  # GPG imports merge into the keyring rather than replacing it, so there is
  # nothing here for the freshness test to protect.
  echo "Restoring GPG keys..."
  passage show gpg/secret-keys | gpg --import
  passage show gpg/public-keys | gpg --import
  passage show gpg/ownertrust | gpg --import-ownertrust

  echo "Restoring SOPS key..."
  restore-secret sops/age-key ~/.config/sops/age/keys.txt

  echo "Restoring keyrings..."
  restore-secret keyrings/login.keyring ~/.local/share/keyrings/login.keyring
  restore-secret keyrings/user.keystore ~/.local/share/keyrings/user.keystore

  echo "Restoring atuin key..."
  restore-secret atuin/key ~/.local/share/atuin/key

  # Restore gh token (for headless environments without keyring). gh keeps the
  # token in the keyring where there is one and in hosts.yml otherwise, so
  # neither is a file restore-secret can write; test hosts.yml for an existing
  # login and leave a working one alone.
  if [[ -f "$HOME/.passage/store/gh/token.age" ]] &&
     [[ ! -s "$HOME/.config/gh/hosts.yml" ]]; then
    echo "Restoring GitHub CLI token (touch YubiKey when prompted)..."
    passage show gh/token | gh auth login --with-token
  else
    echo "SKIPPING: GitHub CLI token (already logged in)"
  fi

  echo "Restoring Claude Code credentials..."
  restore-secret claude/credentials ~/.claude/.credentials.json

  # FIDO2 PAM mapping, absent until the first key is enrolled.
  mkdir -p ~/.config/Yubico && chmod 700 ~/.config/Yubico
  restore-secret yubico/u2f_keys ~/.config/Yubico/u2f_keys

  # UniFi Network API key read by the unifi-mcp launcher, modem admin login
  # read by the DOCSIS stats collector (one multiline entry so a single touch
  # yields both fields: password on line 1, `username:` on line 2), and the
  # Home Assistant long-lived token used for ad-hoc REST queries. Each is
  # absent until added with `passage insert`.
  echo "Restoring service credentials..."
  restore-secret unifi/api-key        ~/.local/etc/unifi-api-key
  restore-secret modem/admin          ~/.local/etc/modem-admin
  restore-secret homeassistant/token  ~/.local/etc/homeassistant-token

  echo "Secrets restored successfully!"
}

install-github-cli() {
  echo 'INSTALLING: GitHub CLI'
  type -p curl || install-common-packages
  curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg | sudo dd of=/usr/share/keyrings/githubcli-archive-keyring.gpg
  sudo chmod go+r /usr/share/keyrings/githubcli-archive-keyring.gpg
  echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" | sudo tee /etc/apt/sources.list.d/github-cli.list
  sudo apt install gh -y
}

install-nvm() {
  local version=$(gh release --repo nvm-sh/nvm view | head -n1 | awk '{print $2}')
  echo "INSTALLING: Node Version Manager (${version}"
  type -p curl || install-common-packages
  curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/${version}/install.sh | bash
  export NVM_DIR="$HOME/.nvm"
  [ -s "$NVM_DIR/nvm.sh" ] && source "$NVM_DIR/nvm.sh"
  nvm install --lts
  nvm install-latest-npm
  # Only append NVM config if it doesn't already exist in .bashrc
  if ! grep -q 'NVM_DIR="$HOME/.nvm"' "$HOME/.bashrc"; then
    echo "Adding NVM configuration to .bashrc"
    cat <<'END' >>"$HOME/.bashrc"
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"
END
  else
    echo "NVM configuration already exists in .bashrc"
  fi
}

setup-editor() {
  echo 'INSTALLING: Neovim'
  type -p gh || install-github-cli
  gh release download --repo neovim/neovim --pattern nvim-linux-x86_64.appimage
  mv nvim-linux-x86_64.appimage ~/.local/bin/nvim.appimage
  chmod +x ~/.local/bin/nvim.appimage
  sudo update-alternatives --install /usr/bin/editor editor ~/.local/bin/nvim.appimage 100
  sudo update-alternatives --auto editor
}

install-lazyvim() {
  echo 'INSTALLING: LazyVim'
  type -p nvm || install-nvm
  type -p gh || install-github-cli
  local nvim_config=$HOME/.config/nvim

  # Wipe config, plugins, state, and cache for a clean slate
  rm -rf "$nvim_config" ~/.local/share/nvim ~/.local/state/nvim ~/.cache/nvim
  git clone https://github.com/LazyVim/starter.git "$nvim_config"
  rm -rf "$nvim_config/.git"

  # Restore personal customizations from dotfiles repo
  git -C ~ restore --source=HEAD -- \
    .config/nvim/lua/plugins/colorscheme.lua \
    .config/nvim/spell/en.utf-8.add \
    .config/nvim/spell/en.utf-8.add.spl

  # Seed lazyvim.json with extras (version must match LazyVim to skip migrations)
  cat > "$nvim_config/lazyvim.json" << 'LAZYVIM_JSON'
{
  "extras": [
    "lazyvim.plugins.extras.ai.claudecode",
    "lazyvim.plugins.extras.lang.json",
    "lazyvim.plugins.extras.lang.markdown",
    "lazyvim.plugins.extras.lang.rust",
    "lazyvim.plugins.extras.lang.toml"
  ],
  "version": 8
}
LAZYVIM_JSON

  npm i -g markdownlint-cli2 markdown-toc prettier
}

install-yubikey-manager() {
  echo 'INSTALLING: YubiKey Manager'
  type -p add-apt-repository || install-common-packages
  sudo add-apt-repository --yes ppa:yubico/stable
  # fido2-tools gives setup-fido-login the fido2-assert probe it uses to order
  # u2f_keys for the attached key. It runs later in this script, and installs
  # the package itself when run standalone; pulling it in here means the PPA
  # build rather than the older one in universe.
  sudo apt install -y yubikey-manager fido2-tools
}

setup-rust() {
  type -p rustup || {
    echo "INSTALLING: Rust dev environment"
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
  }
  echo "UPDATING: Rust tooling"
  . "$HOME/.cargo/env"
  rustup update
  rustup component add rust-analyzer
}

install-golang() {
  echo 'INSTALLING: Go (upstream from go.dev)'
  type -p curl || install-common-packages
  local arch latest current
  arch=$(dpkg --print-architecture)
  latest=$(curl -fsSL 'https://go.dev/VERSION?m=text' | head -n1)
  if [[ -z "$latest" ]]; then
    echo "ERROR: could not fetch latest Go version from go.dev"
    return 1
  fi
  if [[ -x /usr/local/go/bin/go ]]; then
    current=$(/usr/local/go/bin/go version | awk '{print $3}')
  fi
  if [[ "$current" == "$latest" ]]; then
    echo "Go ${latest} already installed"
    return 0
  fi
  echo "Installing ${latest} (was: ${current:-none})"
  local tmp
  tmp=$(mktemp -d)
  curl -fsSL "https://go.dev/dl/${latest}.linux-${arch}.tar.gz" -o "$tmp/go.tar.gz"
  sudo rm -rf /usr/local/go
  sudo tar -C /usr/local -xzf "$tmp/go.tar.gz"
  rm -rf "$tmp"
  /usr/local/go/bin/go version
}

install-go-unifi-mcp() {
  echo 'INSTALLING: go-unifi-mcp (UniFi Network MCP server)'
  [[ -x /usr/local/go/bin/go ]] || install-golang
  # GOBIN lands the binary on the PATH exported above; the Go default of
  # ~/go/bin is not on it, which is what the unifi-mcp launcher expects.
  GOBIN="$HOME/.local/bin" /usr/local/go/bin/go install \
    github.com/claytono/go-unifi-mcp/cmd/go-unifi-mcp@latest
  "$HOME/.local/bin/go-unifi-mcp" -version
}

install-claude-code() {
  echo 'INSTALLING: Claude Code CLI'
  type -p claude && {
    echo "Claude Code is already installed at $(which claude)"
    return 0
  }
  type -p curl || install-common-packages
  curl -fsSL claude.ai/install.sh | bash
  # Verify installation
  if type -p claude > /dev/null; then
    echo "Claude Code $(claude --version) installed successfully"
  else
    echo "Warning: Claude Code installation may have failed"
  fi
}

setup-unifi-mcp() {
  echo 'REGISTERING: unifi MCP server with Claude Code'
  type -p claude || install-claude-code
  # `claude mcp get` exits 0 when the server is registered, even if it cannot
  # connect yet (no key file), and 1 when it is not.
  if claude mcp get unifi > /dev/null 2>&1; then
    echo "unifi MCP server already registered"
    return 0
  fi
  # User scope lands it in ~/.claude.json for every project. The launcher is
  # registered by absolute path: the MCP client's PATH is not ours.
  claude mcp add --scope user unifi -- "$HOME/.local/bin/unifi-mcp"
}

setup-gnome-terminal-gruvbox() {
  type -p dconf || return 0

  # Single "Gruvbox" profile whose palette theme-sync rewrites in place on toggle.
  # UUID matches ~/.config/theme-sync.env.
  local uuid="b1dcc9dd-5262-4d8d-a863-c897e6d979b9"
  local path="/org/gnome/terminal/legacy/profiles:/:${uuid}/"

  dconf write /org/gnome/terminal/legacy/profiles:/list "['${uuid}']"
  dconf write /org/gnome/terminal/legacy/profiles:/default "'${uuid}'"

  dconf write "${path}visible-name" "'Gruvbox'"
  dconf write "${path}use-theme-colors" "false"
  dconf write "${path}bold-is-bright" "true"
  dconf write "${path}font" "'UbuntuMono Nerd Font 16'"
  dconf write "${path}use-system-font" "false"
  # Seed with dark palette; theme-sync will overwrite to match current color-scheme.
  dconf write "${path}background-color" "'#282828'"
  dconf write "${path}foreground-color" "'#ebdbb2'"
  dconf write "${path}palette" "['#282828','#cc241d','#98971a','#d79921','#458588','#b16286','#689d6a','#a89984','#928374','#fb4934','#b8bb26','#fabd2f','#83a598','#d3869b','#8ec07c','#ebdbb2']"
}

setup-gruvbox-gtk-theme() {
  [[ -d "$HOME/.themes/Gruvbox-Dark" ]] && return 0
  echo 'INSTALLING: Gruvbox-GTK-Theme'
  type -p sassc || install-common-packages
  local src=/tmp/gruvbox-gtk-theme
  rm -rf "$src"
  git clone --depth=1 https://github.com/Fausto-Korpsvart/Gruvbox-GTK-Theme.git "$src"
  "$src/themes/install.sh" -d "$HOME/.themes"
  rm -rf "$src"
}

setup-theme-sync() {
  echo 'ENABLING: theme-sync.service (gsettings -> tmux/starship/terminal/GTK)'
  systemctl --user daemon-reload
  systemctl --user enable --now theme-sync.service
  # Apply once so current state matches the GNOME color-scheme.
  "$HOME/.local/bin/theme-sync"
}

setup-terminal() {
  # Set caps lock as ctrl (desktop only)
  type -p dconf && dconf write /org/gnome/desktop/input-sources/xkb-options "['caps:ctrl_modifier']"
  type -p starship || {
    echo "INSTALLING: Starship cross-shell prompt"
    curl -sS https://starship.rs/install.sh | sh -s -- -y
  }
  mkdir -p ~/.local/share/fonts
  gh release download --clobber --repo ryanoasis/nerd-fonts --pattern UbuntuMono.tar.xz --dir ~/.local/share/fonts
  tar -xf ~/.local/share/fonts/UbuntuMono.tar.xz -C ~/.local/share/fonts
  type -p fc-cache && fc-cache

  # Install Tmux Plugin Manager
  if [ ! -d "$HOME/.tmux/plugins/tpm" ]; then
    echo "INSTALLING: Tmux Plugin Manager"
    git clone https://github.com/tmux-plugins/tpm ~/.tmux/plugins/tpm
    # Auto-install plugins if tmux config exists
    if [ -f "$HOME/.tmux.conf" ]; then
      ~/.tmux/plugins/tpm/bin/install_plugins
    fi
  fi

  # Setup GNOME Terminal Gruvbox profiles (dark + light)
  setup-gnome-terminal-gruvbox
  setup-gruvbox-gtk-theme
  setup-theme-sync
}

echo 'UPDATING: APT Repository Lists'
sudo apt update
echo 'UPDATING: All Installed Packages'
sudo apt dist-upgrade -y
echo 'INSTALLING: Baseline Packages'
install-common-packages
install-yubikey-manager
setup-rust
install-passage
install-github-cli

# Restore secrets if Recovery drive is mounted
if [[ -d "$RECOVERY_PATH/passage-store" ]]; then
  restore-secrets
else
  echo "SKIPPING: secrets restoration (Recovery drive not mounted)"
fi

setup-dotfiles() {
  echo 'SETTING UP: dotfiles'
  if [[ -d ~/.git ]]; then
    echo "Dotfiles already set up, pulling latest..."
    git -C ~ pull
    return 0
  fi
  git clone https://github.com/n8behavior/dotfiles /tmp/dotfiles
  mv /tmp/dotfiles/.git ~
  git -C ~ restore .
  rm -rf /tmp/dotfiles
}

setup-dotfiles

# Ensure paths are available for rest of script (dotfiles may have updated .bashrc)
export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$HOME/.atuin/bin:$PATH"

install-atuin() {
  echo 'INSTALLING: Atuin shell history'
  if [[ -d ~/.atuin ]]; then
    echo "Atuin already installed"
    return 0
  fi
  curl --proto '=https' --tlsv1.2 -LsSf https://setup.atuin.sh | sh
}

install-fzf() {
  echo 'INSTALLING: fzf (latest from GitHub)'
  type -p gh || install-github-cli
  local tmp=$(mktemp -d)
  gh release download --repo junegunn/fzf --pattern "fzf-*-linux_amd64.tar.gz" --dir "$tmp"
  tar -xzf "$tmp"/fzf-*-linux_amd64.tar.gz -C "$tmp"
  install -m 755 "$tmp/fzf" ~/.local/bin/fzf
  rm -rf "$tmp"
  echo "fzf $(~/.local/bin/fzf --version) installed"
}

echo 'INSTALLING: Extra Goodies'
install-atuin
install-nvm
install-fzf
install-golang
install-go-unifi-mcp
setup-editor
install-lazyvim
setup-terminal
install-claude-code
setup-unifi-mcp
cargo install aichat

# No-ops until a key is enrolled with enroll-fido-key
setup-fido-login
