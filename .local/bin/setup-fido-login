#!/usr/bin/env bash
# Wire enrolled FIDO2 credentials into PAM: GDM login, screen unlock, sudo, su,
# polkit. Idempotent -- safe to run from bootstrap-dotfiles on every refresh,
# and exits without prompting for a touch or PIN when PAM already matches.
#
# The key is a *primary* auth factor, not a second one: touch+PIN succeeds
# outright, and any failure falls through to the password prompt. There is no
# configuration here that can lock you out.
#
# Enroll first with enroll-fido-key.

set -euo pipefail

CONFIG="$HOME/.local/etc/fido-login.env"
AUTHFILE="$HOME/.config/Yubico/u2f_keys"
PROFILE=/usr/share/pam-configs/n8-u2f
SELFTEST=/etc/pam.d/n8-u2f-selftest
SSHD_DROPIN=/etc/ssh/sshd_config.d/10-no-password-auth.conf

die() { echo "ERROR: $*" >&2; exit 1; }
step() { echo; echo "==> $*"; }

[[ $EUID -ne 0 ]] || die "run as your normal user, not root (needs \$HOME); it will sudo as needed"

[[ -r $CONFIG ]] || die "missing $CONFIG"
# shellcheck source=/dev/null
. "$CONFIG"
[[ -n ${FIDO_ORIGIN:-} && -n ${FIDO_APPID:-} ]] || die "$CONFIG must set FIDO_ORIGIN and FIDO_APPID"

# nodetect: skip the check-only probe pam_u2f normally sends before starting
# the real assertion. Right after resume from suspend the key is enumerated
# but still waking from USB suspend, so the probe fails and the stack silently
# falls through to the password. The real assertion opens with the PIN prompt,
# which gives the key time to wake; with no key attached it still fails fast.
PAM_ARGS="cue origin=$FIDO_ORIGIN appid=$FIDO_APPID pinverification=1 nodetect"

if [[ ! -s $AUTHFILE ]] || ! grep -q "^${USER}:" "$AUTHFILE"; then
  echo "SKIPPING: fido login (no credentials in $AUTHFILE)"
  echo "  Enroll a key with enroll-fido-key, or restore the mapping from passage."
  exit 0
fi

# Needed before the ordering probe below, so this runs on every pass rather
# than only when PAM has drifted. dpkg -s needs no privileges; the sudo only
# happens when something is actually missing.
step 'INSTALLING: pam-u2f tooling'
missing=()
for pkg in libpam-u2f pamu2fcfg pamtester fido2-tools; do
  dpkg -s "$pkg" &> /dev/null || missing+=("$pkg")
done
if (( ${#missing[@]} )); then
  sudo apt install -y "${missing[@]}"
else
  echo "already present"
fi

# nodetect (see PAM_ARGS) turns off the probe pam_u2f uses to work out which
# configured credential the attached key actually holds. Without it the module
# falls back to trying them in file order with a *full* assertion each -- cue,
# touch, PIN -- and only learns of the mismatch after the PIN has been typed.
# Every key shares one mapping, so the host holding the second-listed
# credential pays a doomed touch+PIN before the real one.
#
# So run the probe here instead and float this host's credential to the front.
# Check-only means no user presence and no PIN: nothing to interact with, and
# a key too sleepy to answer just leaves the order alone. The mapping in
# passage stays canonical; only the local copy is ordered.
step 'ORDERING: credentials for the attached key'
order_credentials() {
  local line rest cred handle dev hit cdh
  local -a creds devs matched=() others=()

  line=$(grep "^${USER}:" "$AUTHFILE")
  rest=${line#"${USER}:"}
  IFS=: read -ra creds <<< "$rest"
  if (( ${#creds[@]} < 2 )); then
    echo "only one credential enrolled; nothing to order"
    return 0
  fi

  mapfile -t devs < <(fido2-token -L 2> /dev/null | cut -d: -f1)
  if (( ${#devs[@]} == 0 )); then
    echo "no FIDO authenticator attached; leaving order unchanged"
    return 0
  fi

  # Any 32 bytes will do; the assertion itself is thrown away.
  cdh=$(printf 'n8-u2f-order-probe' | openssl dgst -sha256 -binary | base64 -w0)

  for cred in "${creds[@]}"; do
    handle=${cred%%,*}
    hit=false
    for dev in "${devs[@]}"; do
      # up=false is the whole probe: it asks the authenticator to answer
      # without user presence, which succeeds only for a credential it holds
      # and fails FIDO_ERR_NO_CREDENTIALS otherwise. Setting uv=false as well
      # is rejected outright by a YubiKey 5 (FIDO_ERR_UNSUPPORTED_OPTION), so
      # leave uv alone; pin=false keeps fido2-assert from ever prompting.
      if printf '%s\n%s\n%s\n' "$cdh" "$FIDO_ORIGIN" "$handle" \
        | fido2-assert -G -t up=false -t pin=false "$dev" &> /dev/null; then
        hit=true
        break
      fi
    done
    if $hit; then matched+=("$cred"); else others+=("$cred"); fi
  done

  if (( ${#matched[@]} == 0 )); then
    echo "attached key matches no enrolled credential; leaving order unchanged"
    return 0
  fi

  local reordered tmp
  reordered=$(IFS=:; echo "${USER}:${matched[*]}${others[*]:+:${others[*]}}")

  if [[ $reordered == "$line" ]]; then
    echo "this host's key is already first"
    return 0
  fi

  tmp=$(mktemp)
  awk -v u="$USER" -v r="$reordered" -F: '$1 == u { print r; next } { print }' \
    "$AUTHFILE" > "$tmp"
  install -m 600 "$tmp" "$AUTHFILE"
  rm -f "$tmp"
  echo "moved this host's credential to the front of $AUTHFILE"
}
order_credentials

# The profile content doubles as the idempotency check below: the installed
# copy must be byte-identical and common-auth must carry the same module line.
PROFILE_CONTENT="Name: FIDO2 authentication (n8behavior)
Default: no
Priority: 384
Auth-Type: Primary
Auth:
	[success=end default=ignore]	pam_u2f.so	$PAM_ARGS
Auth-Initial:
	[success=end default=ignore]	pam_u2f.so	$PAM_ARGS"

# Setup costs a pamtester self-test (PIN + touch) plus a sudo per step, so
# skip the whole block when PAM already matches what this run would write.
# Any drift -- a changed FIDO_ORIGIN, new module options, the profile removed
# by pam-auth-update -- fails the comparison and reruns the full setup.
pam_changed=false
if [[ -f $PROFILE ]] \
  && diff -q "$PROFILE" <(printf '%s\n' "$PROFILE_CONTENT") > /dev/null \
  && grep -qF "pam_u2f.so $PAM_ARGS" /etc/pam.d/common-auth; then
  echo "SKIPPING: fido login (common-auth already matches this configuration)"
else
  pam_changed=true

  # Self-test before touching the real auth stack. The mapping file records key
  # handles but not the origin they were registered against, so a mismatched
  # FIDO_ORIGIN is only detectable by actually authenticating.
  step 'VERIFYING: credentials authenticate against this origin'
  printf 'auth required pam_u2f.so %s\n' "$PAM_ARGS" | sudo tee "$SELFTEST" > /dev/null
  echo "Touch the key and enter its PIN."
  pamtester "$(basename "$SELFTEST")" "$USER" authenticate \
    || die "self-test failed; PAM left unchanged. Check that FIDO_ORIGIN matches the value used at enrollment."
  echo "Self-test passed."

  # Authentication belongs in common-auth, never in a per-service file: a
  # pam_u2f line in /etc/pam.d/<service> runs ahead of common-auth and, if
  # sufficient, short-circuits the stack before this profile is consulted.
  step 'INSTALLING: pam-auth-update profile'
  printf '%s\n' "$PROFILE_CONTENT" | sudo tee "$PROFILE" > /dev/null

  sudo pam-auth-update --package --enable n8-u2f
  grep -q pam_u2f /etc/pam.d/common-auth \
    || die "pam-auth-update did not apply; /etc/pam.d/common-auth may be locally modified (see pam-auth-update(8) --force)"
  echo "common-auth now offers the key before the password."
fi

# The PIN requirement lives in common-auth. A pam_u2f line in any per-service
# file runs ahead of it and, if sufficient, short-circuits the stack -- so that
# service would authenticate on whatever terms the stray line sets. Assert that
# common-auth is the only place pam_u2f appears.
shadowing=$(grep -rlE '^[^#]*pam_u2f\.so' /etc/pam.d/ 2> /dev/null \
  | grep -vE "/(common-auth|$(basename "$SELFTEST"))$" || true)
if [[ -n $shadowing ]]; then
  echo
  echo "WARNING: pam_u2f configured outside common-auth. These files run first"
  echo "  and may authenticate without a PIN:"
  sed 's/^/    /' <<< "$shadowing"
fi

# sshd includes common-auth. With PasswordAuthentication on, a remote login would
# run the u2f stack and cue a touch on the authenticator physically attached to
# the *server*. Pubkey auth is unaffected.
step 'HARDENING: sshd (no password auth)'
sshd_changed=false
if ! dpkg -s openssh-server &> /dev/null; then
  echo "openssh-server not installed; nothing to harden"
else
  if [[ ! -f $SSHD_DROPIN ]]; then
    sudo tee "$SSHD_DROPIN" > /dev/null <<'SSHD_EOF'
# common-auth now includes pam_u2f; a password login would cue a touch on the
# server's own authenticator. Pubkey auth is unaffected.
PasswordAuthentication no
SSHD_EOF
    sshd_changed=true
    echo "wrote $SSHD_DROPIN"
  else
    echo "already present"
  fi

  # -G parses the config and its includes. Unlike -t it does not require the
  # privilege-separation directory, which does not exist until sshd first runs.
  sshd -G -f /etc/ssh/sshd_config > /dev/null \
    || die "sshd rejected the config; review $SSHD_DROPIN"

  # Ubuntu socket-activates sshd: ssh.socket is active, ssh.service is not, and
  # each connection spawns a fresh sshd that re-reads the config. Only a
  # long-running ssh.service needs to be told.
  if systemctl is-active --quiet ssh.service; then
    sudo systemctl reload ssh.service
  fi
  echo "config valid"
fi

# etckeeper needs a sudo of its own, so only commit when something changed.
if ($pam_changed || $sshd_changed) && type -p etckeeper > /dev/null; then
  sudo etckeeper commit 'fido login: enable pam_u2f via pam-auth-update' &> /dev/null || true
fi

$pam_changed || exit 0

cat <<'DONE'

==> Done. Verify in this order, keeping a root shell open:

  1. sudo -k && sudo true      touch + PIN
  2. Super+L                   lock screen (recoverable from a TTY)
  3. reboot                    GDM greeter

Your password still works everywhere the key does. On first use of a
credential store each session, GNOME will ask for your keyring password:
pam_u2f has no secret to hand it, so that prompt is expected.
DONE
